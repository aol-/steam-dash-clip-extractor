#!/usr/bin/env python3
"""
Trigger Quake Live Steam clip extraction on demand (bound to Keypad Minus).
"""
import os
import sys
import time
import subprocess
from pathlib import Path

def notify(title, body="", icon="video-x-generic", expire_ms=3000):
    subprocess.Popen(
        ["notify-send", "-a", "Steam Clip Extractor", "-i", icon, "-t", str(expire_ms), title, body],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL
    )

def play_sound(sound_name):
    path = f"/usr/share/sounds/freedesktop/stereo/{sound_name}.oga"
    if os.path.exists(path):
        subprocess.Popen(["pw-play", path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def main():
    notify("⏳ Processing Quake Live Clip...", "Extracting 1440p MP4 in background...", expire_ms=2500)
    play_sound("message-new-instant")

    # Give Steam up to 1.5s to finish writing segments if triggered right after recording
    time.sleep(1.5)

    res = subprocess.run(
        ["$HOME/.local/bin/steam-extract-clips", "--force"],
        capture_output=True,
        text=True
    )

    output = res.stdout.strip()
    extracted_lines = [l for l in output.splitlines() if "[+] Extracted:" in l]

    if extracted_lines:
        count = len(extracted_lines)
        latest = extracted_lines[-1].replace("[+] Extracted: ", "")
        notify(
            "🎬 Clip Processing Complete!",
            f"Exported {count} clip(s):\n{latest}",
            icon="dialog-ok",
            expire_ms=5000
        )
        play_sound("complete")
    elif "All matching clips are already extracted" in output:
        notify(
            "Quake Live Clips",
            "All clips are already processed! No new clips pending.",
            icon="dialog-information",
            expire_ms=3000
        )
    else:
        notify("Steam Clips", output or "Finished checking clips.", expire_ms=3000)

if __name__ == "__main__":
    main()
